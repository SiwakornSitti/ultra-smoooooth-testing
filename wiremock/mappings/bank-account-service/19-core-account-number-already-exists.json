      "code": "ACCOUNT_NUMBER_ALREADY_EXISTS"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "persistent": true,
  "metadata": {
    "wiremock-gui": {
      "folder": "/core"
    }
  }
}
