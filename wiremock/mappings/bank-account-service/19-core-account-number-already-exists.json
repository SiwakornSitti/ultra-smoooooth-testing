{
  "name": "Bank Account Mock - Account Number Already Exists",
  "request": {
    "urlPath": "/accounts",
    "method": "POST",
    "headers": {
      "Mock-Scenario": {
        "contains": "BANK_ACCOUNT:ACCOUNT_NUMBER_ALREADY_EXISTS"
      }
    }
  },
  "response": {
    "status": 409,
    "jsonBody": {
