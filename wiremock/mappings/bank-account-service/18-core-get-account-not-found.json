{
  "name": "Bank Account Service Mock - Account Not Found",
  "request": {
    "urlPathPattern": "/accounts/.*",
    "method": "GET",
    "headers": {
      "Mock-Scenario": {
        "contains": "BANK_ACCOUNT:GET_ACCOUNT_NOT_FOUND"
      }
    }
  },
  "response": {
    "status": 404,
    "jsonBody": {
      "error": "Account not found"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "persistent": true,
  "metadata": {
    "wiremock-gui": {
      "folder": "/bank-account-service"
    }
  }
}
