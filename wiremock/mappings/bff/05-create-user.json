{
  "name": "BFF Mock - Create User",
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/users",
    "headers": {
      "Mock-Scenario": {
        "contains": "BFF:CREATE_USER"
      }
    }
  },
  "response": {
    "status": 201,
    "jsonBody": {
      "id": "frontend-mock-user-001",
      "name": "{{jsonPath request.body '$.name' default='Mock User'}}",
      "email": "{{jsonPath request.body '$.email' default='mock@example.com'}}",
      "phone": "{{jsonPath request.body '$.phone' default='+66000000000'}}",
      "status": "{{jsonPath request.body '$.status' default='active'}}"
    },
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "transformers": ["response-template"]
  }
}
