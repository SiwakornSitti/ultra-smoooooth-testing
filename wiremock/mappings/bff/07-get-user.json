{
  "name": "BFF Mock - Get User Profile",
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v1/users/[^/]+",
    "headers": {
      "Mock-Scenario": {
        "contains": "BFF:GET_USER"
      }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "user": {
        "id": "frontend-mock-user-001",
        "name": "Frontend Mock User",
        "email": "frontend@example.com",
        "status": "active"
      },
      "accounts": [
        {
          "id": "frontend-mock-account-001",
          "user_id": "frontend-mock-user-001",
          "balance": 1000,
          "currency": "USD"
        }
      ]
    },
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    }
  }
}
