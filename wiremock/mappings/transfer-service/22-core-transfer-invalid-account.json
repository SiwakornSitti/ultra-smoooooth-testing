{
  "name": "Core Mock - Transfer Invalid Account",
  "request": {
    "urlPath": "/transfers",
    "method": "POST",
    "headers": {
      "Mock-Scenario": {
        "contains": "TRANSFER:INVALID_ACCOUNT"
      }
    }
  },
  "response": {
