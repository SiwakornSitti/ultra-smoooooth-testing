{
  "name": "Proxy - Real eKYC Service",
  "priority": 100,
  "request": {
    "urlPathPattern": "/ekycs(/.*)?",
    "method": "ANY"
  },
  "response": {
    "proxyBaseUrl": "http://ekyc-service:8080"
  },
  "persistent": true,
  "metadata": {
    "wiremock-gui": {
      "folder": "/ekyc-service"
    }
  }
}
