{
  "proxy": {
    "request_listeners": [
      {
        "certificate_mode": "per_host",
        "listen_mode": "loopback_only",
        "listener_port": 8080,
        "running": true
      }
    ],
    "match_replace_rules": [
      {
        "comment": "Inject Mock-Scenario Header for Paotang Pass Success",
        "enabled": false,
        "is_simple_match": true,
        "match": "",
        "replace": "Mock-Scenario: PT_PASS:SUCCESS",
        "rule_type": "request_header"
      }
    ]
  }
}
