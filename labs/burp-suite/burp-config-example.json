{
  "target": {
    "scope": {
      "advanced_mode": true,
      "exclude": [],
      "include": [
        {
          "enabled": true,
          "file": "",
          "host": "^192\\.168\\.1\\.[0-9]{1,3}$",
          "port": "^\\d+$",
          "protocol": "^https?$",
          "path": ".*"
        }
      ]
    }
  },
  "proxy": {
    "request_listeners": [
      {
        "certificate_mode": "per_host",
        "listen_mode": "all_interfaces",
        "listener_port": 8080,
        "running": true
      }
    ],
    "match_replace_rules": [
      {
        "comment": "Inject Mock-Scenario Header for Paotang Pass Success",
        "enabled": false,
        "is_simple_match": true,
        "match": "",
        "replace": "Mock-Scenario: PT_PASS:SUCCESS",
        "rule_type": "request_header"
      }
    ]
  }
}
